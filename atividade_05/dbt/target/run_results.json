\u00edcios\") AS nota_remuneracao,\n    AVG(\"Recomendam para outras pessoas(%)\") AS pct_recomendam\nFROM raw.empregados\nWHERE \"Nome\" IS NOT NULL AND TRIM(\"Nome\") != ''\nGROUP BY UPPER(TRIM(\"Nome\"))", "relation_name": "\"eedb022_a5\".\"trusted\".\"trusted_empregados\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-06T21:01:21.152125Z", "completed_at": "2026-09-06T21:01:21.875027Z"}, {"name": "execute", "started_at": "2026-09-06T21:01:21.983656Z", "completed_at": "2026-09-06T21:01:22.951667Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 1.8125245571136475, "adapter_response": {"_message": "SELECT 437", "code": "SELECT", "rows_affected": 437}, "message": "SELECT 437", "failures": null, "unique_id": "model.eedb022_dbt.trusted_reclamacoes", "compiled": true, "compiled_code": "SELECT DISTINCT\n    \"Ano\" AS ano,\n    \"Trimestre\" AS trimestre,\n    LPAD(TRIM(\"CNPJ IF\"), 8, '0') AS cnpj,\n    \"Institui\u00e7\u00e3o financeira\" AS instituicao,\n    \"Quantidade total de reclama\u00e7\u00f5es\" AS qtd_reclamacoes\nFROM raw.reclamacoes\nWHERE \"CNPJ IF\" IS NOT NULL AND TRIM(\"CNPJ IF\") != ''", "relation_name": "\"eedb022_a5\".\"trusted\".\"trusted_reclamacoes\"", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-06T21:01:22.980298Z", "completed_at": "2026-09-06T21:01:23.013722Z"}, {"name": "execute", "started_at": "2026-09-06T21:01:23.015818Z", "completed_at": "2026-09-06T21:01:23.391540Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.41768527030944824, "adapter_response": {"_message": "SELECT 1472", "code": "SELECT", "rows_affected": 1472}, "message": "SELECT 1472", "failures": null, "unique_id": "model.eedb022_dbt.delivery_final", "compiled": true, "compiled_code": "\n\nWITH reclamacoes_agg AS (\n    SELECT\n        cnpj,\n        SUM(qtd_reclamacoes) AS total_reclamacoes\n    FROM \"eedb022_a5\".\"trusted\".\"trusted_reclamacoes\"\n    GROUP BY cnpj\n)\n\nSELECT\n    b.cnpj,\n    b.nome_completo AS nome,\n    b.segmento,\n    COALESCE(r.total_reclamacoes, 0) AS total_reclamacoes,\n    e.nota_geral,\n    e.nota_remuneracao,\n    e.pct_recomendam\nFROM \"eedb022_a5\".\"trusted\".\"trusted_bancos\" b\nLEFT JOIN reclamacoes_agg r ON b.cnpj = r.cnpj\nLEFT JOIN \"eedb022_a5\".\"trusted\".\"trusted_empregados\" e ON b.nome_busca = e.nome", "relation_name": "\"eedb022_a5\".\"delivery\".\"delivery_final\"", "batch_results": null, "overload_results": null}], "elapsed_time": 3.241624593734741, "args": {"empty": false, "write_json": true, "vars": {}, "use_catalogs_v2": false, "print": true, "quiet": false, "require_nested_cumulative_type_params": true, "state_modified_compare_vars": false, "log_file_max_bytes": 10485760, "introspect": true, "printer_width": 80, "exclude": [], "log_path": "/opt/atividade_05/dbt/logs", "defer": false, "require_corrected_analysis_fqns": false, "v2_parser": "dbt-core-experimental-parser parse", "latest_version_pointer_enabled_by_default": false, "select": [], "use_v2_parser": false, "send_anonymous_usage_stats": true, "use_colors_file": true, "populate_cache": true, "project_dir": "/opt/atividade_05/dbt", "use_fast_test_edges": false, "upload_to_artifacts_ingest_api": false, "which": "run", "cache_selected_only": false, "require_all_warnings_handled_by_warn_error": true, "macro_debugging": false, "show_all_deprecations": false, "log_level": "info", "hints_enabled": true, "require_unique_project_resource_names": false, "require_resource_names_without_spaces": true, "state_modified_compare_more_unrendered_values": true, "require_sql_header_in_test_configs": false, "maximum_seed_size_mib": 1, "partial_parse": true, "indirect_selection": "eager", "require_explicit_package_overrides_for_builtin_materializations": true, "support_custom_ref_kwargs": false, "version_check": true, "require_source_and_semantic_model_names_without_spac