<?xml version="1.0" encoding="UTF-8"?>
<workflow>
  <name>workflow_principal</name>
  <name_sync_with_filename>Y</name_sync_with_filename>
  <status_for_child_workflow_output>-1</status_for_child_workflow_output>
  <actions>
    <action>
      <name>Start</name>
      <description/>
      <type>SPECIAL</type>
      <attributes/>
      <repeat>N</repeat>
      <schedulerType>0</schedulerType>
      <intervalSeconds>0</intervalSeconds>
      <intervalMinutes>60</intervalMinutes>
      <hour>12</hour>
      <minutes>0</minutes>
      <weekDay>1</weekDay>
      <DayOfMonth>1</DayOfMonth>
      <parallel>N</parallel>
      <xloc>80</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>criar_tabelas_sql</name>
      <description/>
      <type>SQL</type>
      <attributes/>
      <sql>CREATE TABLE IF NOT EXISTS "stg_bancos" (
  "Segmento" VARCHAR(255),
  "CNPJ" VARCHAR(255),
  "Nome" VARCHAR(255)
);

CREATE TABLE IF NOT EXISTS "stg_reclamacoes" (
  "Ano" BIGINT,
  "Trimestre" TEXT,
  "Categoria" TEXT,
  "Tipo" TEXT,
  "CNPJ_IF" TEXT,
  "Instituição_financeira" TEXT,
  "Índice" NUMERIC,
  "Quantidade_de_reclamações_reguladas_procedentes" BIGINT,
  "Quantidade_de_reclamações_reguladas___outras" BIGINT,
  "Quantidade_de_reclamações_não_reguladas" BIGINT,
  "Quantidade_total_de_reclamações" BIGINT,
  "Quantidade_total_de_clientes_ _CCS_e_SCR" BIGINT,
  "Quantidade_de_clientes_ _CCS" NUMERIC,
  "Quantidade_de_clientes_ _SCR" NUMERIC
);

CREATE TABLE IF NOT EXISTS "stg_empregados" (
  "employer_name" TEXT,
  "reviews_count" BIGINT,
  "culture_count" BIGINT,
  "salaries_count" BIGINT,
  "benefits_count" BIGINT,
  "employer_website" TEXT,
  "employer_headquarters" TEXT,
  "employer_founded" NUMERIC,
  "employer_industry" TEXT,
  "employer_revenue" TEXT,
  "url" TEXT,
  "Geral" NUMERIC,
  "Cultura_e_valores" NUMERIC,
  "Diversidade_e_inclusão" NUMERIC,
  "Qualidade_de_vida" NUMERIC,
  "Alta_liderança" NUMERIC,
  "Remuneração_e_benefícios" NUMERIC,
  "Oportunidades_de_carreira" NUMERIC,
  "Recomendam_para_outras_pessoas(%)" NUMERIC,
  "Perspectiva_positiva_da_empresa(%)" NUMERIC,
  "Segmento" TEXT,
  "CNPJ" TEXT,
  "Nome" TEXT,
  "match_percent" BIGINT
);

CREATE TABLE IF NOT EXISTS "tb_final_bancos_reclamacoes" (
  "Ano" BIGINT,
  "Trimestre" TEXT,
  "Categoria" TEXT,
  "Tipo" TEXT,
  "CNPJ_IF" TEXT,
  "Instituição_financeira" TEXT,
  "Índice" DOUBLE PRECISION,
  "Quantidade_de_reclamações_reguladas_procedentes" BIGINT,
  "Quantidade_de_reclamações_reguladas___outras" BIGINT,
  "Quantidade_de_reclamações_não_reguladas" BIGINT,
  "Quantidade_total_de_reclamações" BIGINT,
  "Quantidade_total_de_clientes_ _CCS_e_SCR" BIGINT,
  "Quantidade_de_clientes_ _CCS" DOUBLE PRECISION,
  "Quantidade_de_clientes_ _SCR" DOUBLE PRECISION,
  "CNPJ_padronizado" TEXT,
  "nome" VARCHAR(255),
  "segmento" TEXT,
  "cultura_e_valores" DOUBLE PRECISION,
  "geral" DOUBLE PRECISION,
  "remuneração_e_benefícios" DOUBLE PRECISION,
  "reviews_count" BIGINT
);
</sql>
      <useVariableSubstitution>F</useVariableSubstitution>
      <sqlfromfile>F</sqlfromfile>
      <sqlfilename/>
      <sendOneStatement>F</sendOneStatement>
      <connection>pg_eedb022</connection>
      <parallel>N</parallel>
      <xloc>220</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>pipeline_ingestao_bancos.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/atividade_01/pipeline_ingestao_bancos.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters/>
      <parallel>N</parallel>
      <xloc>400</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>pipeline_ingestao_empregados.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/atividade_01/pipeline_ingestao_empregados.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters/>
      <parallel>N</parallel>
      <xloc>600</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>pipeline_ingestao_reclamacoes.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/atividade_01/pipeline_ingestao_reclamacoes.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters/>
      <parallel>N</parallel>
      <xloc>800</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>pipeline_tratamento_final.hpl</name>
      <description/>
      <type>PIPELINE</type>
      <attributes/>
      <filename>${PROJECT_HOME}/atividade_01/pipeline_tratamento_final.hpl</filename>
      <params_from_previous>N</params_from_previous>
      <exec_per_row>N</exec_per_row>
      <clear_rows>N</clear_rows>
      <clear_files>N</clear_files>
      <set_logfile>N</set_logfile>
      <logfile/>
      <logext/>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <loglevel>Basic</loglevel>
      <set_append_logfile>N</set_append_logfile>
      <wait_until_finished>Y</wait_until_finished>
      <follow_abort_remote>N</follow_abort_remote>
      <create_parent_folder>N</create_parent_folder>
      <run_configuration>local</run_configuration>
      <parameters/>
      <parallel>N</parallel>
      <xloc>1000</xloc>
      <yloc>160</yloc>
    </action>
    <action>
      <name>Success</name>
      <description/>
      <type>SUCCESS</type>
      <attributes/>
      <parallel>N</parallel>
      <xloc>1160</xloc>
      <yloc>160</yloc>
    </action>
  </actions>
  <hops>
    <hop>
      <from>Start</from>
      <to>criar_tabelas_sql</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>Y</unconditional>
    </hop>
    <hop>
      <from>criar_tabelas_sql</from>
      <to>pipeline_ingestao_bancos.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pipeline_ingestao_bancos.hpl</from>
      <to>pipeline_ingestao_empregados.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pipeline_ingestao_empregados.hpl</from>
      <to>pipeline_ingestao_reclamacoes.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pipeline_ingestao_reclamacoes.hpl</from>
      <to>pipeline_tratamento_final.hpl</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
    <hop>
      <from>pipeline_tratamento_final.hpl</from>
      <to>Success</to>
      <enabled>Y</enabled>
      <evaluation>Y</evaluation>
      <unconditional>N</unconditional>
    </hop>
  </hops>
  <notepads/>
  <attributes/>
</workflow>
